<!DOCTYPE html>
<html lang="pt-br">
  <head>
    <meta charset="UTF-8" />
    <title>Detalhes de <%= cliente.nome %></title>
  </head>
  <body>
    <h1>Detalhes do Cliente</h1>
    <p><strong>ID:</strong> <%= cliente.id %></p>
    <p><strong>Nome:</strong> <%= cliente.nome %></p>
    <p>
      <strong>Email:</strong> <%= cliente.email %>
    </p>
    <br />
    <br>
    <a href="/clientes/editar/<%= cliente.id %>">Editar</a>
    <form method="POST" action="/clientes/deletar/<%= cliente.id %>?_method=DELETE" style="display:inline">
      <input type="hidden" name="_method" value="DELETE">
      <button type="submit">Deletar</button>
    </form>
    <br />
    <a href="/clientes">Voltar para a lista</a>
  </body>
</html>